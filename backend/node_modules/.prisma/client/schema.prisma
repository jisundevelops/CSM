generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users         User[]
  assets        Asset[]
  findings      Finding[]
  risks         Risk[]
  tasks         Task[]
  verifications Verification[]
  evidences     Evidence[]
  auditLogs     AuditLog[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  role           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization  Organization @relation(fields: [organizationId], references: [id])
  assignedTasks Task[]       @relation("AssignedTasks")
  auditLogs     AuditLog[]   @relation("ActorLogs")

  @@map("users")
}

model Asset {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  type           String
  identifier     String
  criticality    String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  findings     Finding[]

  @@map("assets")
}

model Finding {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  assetId        String   @map("asset_id")
  scannerSource  String   @map("scanner_source")
  fingerprint    String
  title          String
  description    String?
  severity       String
  confidence     String
  status         String   @default("open")
  firstSeen      DateTime @default(now()) @map("first_seen")
  lastSeen       DateTime @default(now()) @map("last_seen")
  rawEvidence    Json?    @map("raw_evidence")

  organization Organization @relation(fields: [organizationId], references: [id])
  asset        Asset        @relation(fields: [assetId], references: [id])
  risks        Risk[]
  tasks        Task[]
  evidences    Evidence[]

  @@map("findings")
}

model Risk {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  findingId      String   @map("finding_id")
  score          Int
  factorsJson    Json?    @map("factors_json")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  finding      Finding      @relation(fields: [findingId], references: [id])

  @@map("risks")
}

model Task {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  findingId      String   @map("finding_id")
  assignedTo     String?  @map("assigned_to")
  status         String   @default("open")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  finding       Finding        @relation(fields: [findingId], references: [id])
  assignee      User?          @relation("AssignedTasks", fields: [assignedTo], references: [id])
  verifications Verification[]

  @@map("tasks")
}

model Verification {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  taskId         String   @map("task_id")
  verifiedBy     String   @map("verified_by")
  result         String
  verifiedAt     DateTime @default(now()) @map("verified_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  task         Task         @relation(fields: [taskId], references: [id])

  @@map("verifications")
}

model Evidence {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  findingId      String   @map("finding_id")
  type           String
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  finding      Finding      @relation(fields: [findingId], references: [id])

  @@map("evidence")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  actorId        String?  @map("actor_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  timestamp      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation("ActorLogs", fields: [actorId], references: [id])

  @@map("audit_logs")
}
